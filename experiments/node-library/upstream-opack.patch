+++ b/src/mrp/__tests__/volume-output.test.ts
@@ -0,0 +1,47 @@
+import { describe, expect, it } from 'vitest';
+import { MRPMessage, MessageType } from '../messages.js';
+
+// Independently encoded by pyatv 0.18.0, using synthetic identifiers only.
+const volume = {
+  result: '0832120b726561642d766f6c756d65b203050d0000c03e',
+  zero: '0832120b726561642d766f6c756d65b203050d00000000',
+  absent: '0832120b726561642d766f6c756d65b20300',
+  request: '0831120b726561642d766f6c756d65aa03120a1073796e7468657469632d6f7574707574',
+};
+// pyatv 0.18.0 SharedSystemAudio request for one personal output (type 2 merged as a raw varint).
+const personalRoute =
+  '0830120c726f7574652d6f7574707574a20338221973796e7468657469632d706572736f6e616c2d6f75747075743a19' +
+  '73796e7468657469632d706572736f6e616c2d6f75747075740802';
+const decode = (hex: string) => MRPMessage.decode(Buffer.from(hex, 'hex'));
+
+describe('volume reads', () => {
+  it('encodes GetVolume as pyatv does, with a fresh identifier', async () => {
+    const reference = await decode(volume.request);
+    const decoded = await MRPMessage.decode(await MRPMessage.getVolume('synthetic-output'));
+    expect(decoded.type).toBe(MessageType.GetVolume);
+    expect(decoded['.getVolumeMessage']).toEqual(reference['.getVolumeMessage']);
+    expect(decoded.identifier).toBeTruthy();
+    expect((await MRPMessage.decode(await MRPMessage.getVolume('synthetic-output'))).identifier).not.toBe(decoded.identifier);
+  });
+
+  it('decodes GetVolumeResult and keeps a missing level distinct from zero', async () => {
+    const result = await decode(volume.result);
+    expect(result.type).toBe(MessageType.GetVolumeResult);
+    expect(result['.getVolumeResultMessage']).toEqual({ volume: 0.375 });
+    expect(Object.hasOwn((await decode(volume.zero))['.getVolumeResultMessage'] as object, 'volume')).toBe(true);
+    expect(Object.hasOwn((await decode(volume.absent))['.getVolumeResultMessage'] as object, 'volume')).toBe(false);
+  });
+});
+
+describe('output context type', () => {
+  it('defaults to SharedAudioPresentation and can select SharedSystemAudio as pyatv does', async () => {
+    const legacy = await MRPMessage.decode(await MRPMessage.modifyOutputDevices('set', ['x']));
+    expect(legacy['.modifyOutputContextRequestMessage']).toMatchObject({ type: 1 });
+    const reference = await decode(personalRoute);
+    const decoded = await MRPMessage.decode(
+      await MRPMessage.modifyOutputDevices('set', ['synthetic-personal-output'], 2),
+    );
+    expect(decoded.type).toBe(MessageType.ModifyOutputContextRequest);
+    expect(decoded['.modifyOutputContextRequestMessage']).toEqual(reference['.modifyOutputContextRequestMessage']);
+  });
+});
