diff --git a/src/mrp/__tests__/metadata.test.ts b/src/mrp/__tests__/metadata.test.ts
new file mode 100644
index 0000000..ba93f12
--- /dev/null
+++ b/src/mrp/__tests__/metadata.test.ts
@@ -0,0 +1,54 @@
+import { readFileSync } from 'node:fs';
+import { describe, it, expect } from 'vitest';
+import { MRPMessage } from '../messages.js';
+import { Message } from '../../message.js';
+import { parseDataStreamFrame } from '../../util/data-stream.js';
+
+// Generated by companion-module-apple-tv's locked pyatv mrp_fixtures.py.
+// The independent encoder uses synthetic identifiers and content only.
+const reference = JSON.parse(readFileSync(new URL('./metadata-fixtures.json', import.meta.url), 'utf8'));
+const decode = (name: string) => MRPMessage.decode(Buffer.from(reference.messages[name], 'hex'));
+
+describe('independent pyatv metadata packets', () => {
+  it('decodes every message in an independently encoded batch', async () => {
+    const frame = parseDataStreamFrame(Buffer.from(reference.batch, 'hex'))!;
+    const messages = await Promise.all(frame.protobufMessages.map(data => MRPMessage.decode(data)));
+    expect(messages.map(message => new Message(message).type)).toEqual([15, 17, 64, 52, 46, 47, 4, 56, 54, 53, 0, 0]);
+  });
+
+  it('retains volume, capabilities and authenticated output identities', async () => {
+    expect((await decode('device'))['.deviceInfoMessage']).toMatchObject({
+      deviceUID: 'tv-output', clusterID: 'cluster-output', isGroupLeader: true,
+      groupedDevices: [{ name: 'Synthetic speaker', deviceUID: 'speaker-output' }],
+    });
+    expect((await decode('capabilities'))['.volumeControlCapabilitiesDidChangeMessage']).toMatchObject({
+      outputDeviceUID: 'cluster-output', capabilities: { volumeControlAvailable: true, volumeCapabilities: 3 },
+    });
+    const volume = (await decode('volume'))['.volumeDidChangeMessage'] as Record<string, unknown>;
+    expect(volume.outputDeviceUID).toBe('cluster-output');
+    expect(volume.volume).toBeCloseTo(0.3);
+  });
+
+  it('retains active player selection, queue metadata and removals', async () => {
+    expect((await decode('player'))['.setNowPlayingPlayerMessage']).toMatchObject({
+      playerPath: { client: { bundleIdentifier: 'test.player' }, player: { identifier: 'main' } },
+    });
+    expect((await decode('state'))['.setStateMessage']).toMatchObject({
+      playbackState: 1,
+      playbackQueue: { location: 0, contentItems: [{ identifier: 'item-1', metadata: { title: 'Synthetic title', elapsedTime: 12 } }] },
+    });
+    expect((await decode('removePlayer'))['.removePlayerMessage']).toMatchObject({
+      playerPath: { player: { identifier: 'main' } },
+    });
+    expect((await decode('removeClient'))['.removeClientMessage']).toMatchObject({
+      client: { bundleIdentifier: 'test.player' },
+    });
+  });
+
+  it('preserves protocol errors and does not turn acknowledgements into commands', async () => {
+    const ack = await decode('ack');
+    expect(Object.hasOwn(ack, 'type')).toBe(false);
+    expect(new Message(ack).type).toBe(0);
+    expect(await decode('error')).toMatchObject({ errorCode: 6, errorDescription: 'Synthetic rejection' });
+  });
+});
