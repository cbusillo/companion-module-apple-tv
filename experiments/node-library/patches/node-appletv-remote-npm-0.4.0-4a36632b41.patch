+     */
+    create<T>(key: string, timeoutMs: number, options?: {
+        fatalTimeout?: boolean;
+    }): Promise<T>;
+    has(key: string): boolean;
+    resolve(key: string, value: unknown): void;
+    reject(key: string, error: Error): void;
+    rejectAll(error: Error): void;
+}
