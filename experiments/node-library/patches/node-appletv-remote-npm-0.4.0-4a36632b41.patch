+                settled = true;
+                clearTimeout(timer);
+                signal?.removeEventListener('abort', abort);
+                this.pending = undefined;
+                if (error) {
+                    if (sequence === undefined)
+                        this.socket.destroy(); // Anonymous HTTP replies cannot be safely reused after cancellation.
+                    else {
+                        this.abandoned.add(sequence);
+                        if (this.abandoned.size > 64)
+                            this.abandoned.delete(this.abandoned.values().next().value);
+                    }
+                    reject(error);
+                }
+                else if (!allowError && response.code !== 200)
+                    reject(new Error(`RAOP ${method}: ${response.code} ${response.code === 401 || response.code === 403 ? '(authentication rejected)' : ''}`));
+                else
+                    resolve(response);
+            };
+            this.pending = { sequence, protocol, resolve: response => finish(undefined, response), reject: error => finish(error) };
+            signal?.addEventListener('abort', abort, { once: true });
+            const controlHeaders = http ? 'User-Agent: AirPlay/320.20\r\n' :
+                `CSeq: ${sequence}\r\nUser-Agent: AirPlay/550.10\r\nDACP-ID: ${this.senderId}\r\nClient-Instance: ${this.senderId}\r\nActive-Remote: ${this.activeRemote}\r\n`;
