+/** Shared MRP handshake, UUID response correlation, and lifecycle-safe message delivery. */
+import { EventEmitter } from 'node:events';
+import { setTimeout as delay } from 'node:timers/promises';
+import { MRPMessage, MessageType, PLAYER_STATE_FIELDS } from './messages.js';
+/** MRP envelope error "Could not find the specified now playing client": nothing is playing (#10). */
+export const MRP_ERROR_NO_NOW_PLAYING_CLIENT = 35;
+/**
+ * Non-player-state types the diagnostic reports, mapped to the payload field it reads client and
+ * player tokens from ('' for none): handshake requests, volume capabilities and tvOS 26 client properties.
+ */
+const DIAGNOSTIC_FIELDS = {
+    [MessageType.PlaybackQueueRequest]: '.playbackQueueRequestMessage',
+    [MessageType.DeviceInfo]: '',
+    [MessageType.ClientUpdatesConfig]: '',
+    [MessageType.GetKeyboardSession]: '',
+    [MessageType.SetConnectionState]: '',
+    [MessageType.GetVolumeControlCapabilities]: '',
+    [MessageType.GetVolumeControlCapabilitiesResult]: '',
+    [MessageType.VolumeControlCapabilitiesDidChange]: '',
+    [MessageType.PlayerClientProperties]: '.playerClientPropertiesMessage',
+    [MessageType.OriginClientProperties]: '',
+};
+/** True for an envelope that reports a nonzero `errorCode`. */
+function isErrorReply(msg) {
+    return typeof msg.errorCode === 'number' && msg.errorCode !== 0;
+}
+function mrpReplyError(msg) {
+    const errorCode = msg.errorCode;
+    return Object.assign(new Error(`MRP request failed: errorCode=${errorCode} ${msg.errorDescription ?? ''}`.trim()), { errorCode });
+}
+/** Common protocol state for AirPlay-tunneled and standalone MRP transports. */
+export class MRPConnection extends EventEmitter {
+    credentials;
+    settleMs;
+    closed = false;
+    mrpGeneration = 0;
+    /** In-memory equality tokens, capped at the 1024 most recently used values (LRU); discarded with this connection, never persisted. */
+    diagnosticIds = new Map();
+    diagnosticCount = 0;
+    pendingMRPResolvers = [];
+    constructor(credentials, settleMs = 0) {
+        super();
+        this.credentials = credentials;
+        this.settleMs = settleMs;
+    }
