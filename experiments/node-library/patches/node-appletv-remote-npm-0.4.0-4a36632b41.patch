+/** A direct MRP TCP connection for older tvOS, separate from AirPlay credentials. */
+export declare class LegacyMRPConnection extends MRPConnection {
+    private host;
+    private port;
+    private socket?;
+    private connecting;
+    private setupAbort?;
+    private heartbeatInFlight;
+    private pendingWrites;
+    private buffer;
+    private outputKey?;
+    private inputKey?;
+    private outCounter;
+    private inCounter;
+    private heartbeat?;
+    private receiving;
+    private encryptionReady?;
+    private releaseEncryption?;
+    constructor(host: string, port: number, credentials: HAPCredentials, settleMs?: number);
+    /** Open, verify and subscribe; reject overlapping setup. Close cancels setup; await it before reuse. */
+    connect(): Promise<void>;
+    /**
+     * One heartbeat (one retry): any reply carrying the request's identifier counts;
+     * a miss is retried at once, and a second miss fails the connection.
+     */
+    private heartbeatOnce;
+    /** Reject active exchanges before optionally delivering an error event. */
+    private fail;
+    private open;
+    /** PairSetup's HTTP-shaped carrier maps every TLV exchange to CryptoPairing on this socket. */
+    pairingTransport(): {
+        post: (path: string, body: Buffer) => Promise<Buffer>;
+        destroy: () => void;
+    };
+    /** Start DeviceInfo and M1; keep one pairing identity and cache M2 for finish(pin). */
+    startPairing(): Promise<PairSetup>;
+    protected authenticateMRP(): Promise<void>;
+    /** Encrypt the protobuf (not its varint length), with one counter nonce per message. */
+    sendMRPMessage(data: Buffer): Promise<void>;
+    private receive;
+    /** Cancel setup/writes/waiters, invalidate decodes, clear encryption and stop the heartbeat. */
+    close(reason?: Error): void;
+}
