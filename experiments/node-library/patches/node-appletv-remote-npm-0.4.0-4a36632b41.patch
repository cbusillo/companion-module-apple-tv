+            serverPort: port(stream.dataPort, 'dataPort'), controlPort: port(stream.controlPort, 'controlPort'),
+            audioKey, events, session: reply.headers.session?.split(';')[0],
+        };
+    }
+    catch (error) {
+        if (events) {
+            events.removeListener('close', closed);
+            events.destroy();
+        }
