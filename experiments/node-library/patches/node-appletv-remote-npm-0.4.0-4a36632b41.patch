+            try {
+                const wire = Buffer.concat([Buffer.from(message), body]);
+                const sealed = this.cipher?.encrypt(wire);
+                if (sealed)
+                    wire.fill(0); // Encrypted bodies may carry keys (the AirPlay 2 stream SETUP's shk).
+                this.socket.write(sealed ?? wire, error => { if (error)
+                    finish(error); });
+            }
+            catch (error) {
+                finish(error);
+            }
+        }));
+        this.queue = request.catch(() => undefined);
+        return request;
+    }
+}
