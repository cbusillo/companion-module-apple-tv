+/** Correlated waits with exact cleanup and a shared connection shutdown boundary. */
+export class PendingRequests {
+    onTimeout;
+    entries = new Map();
+    constructor(onTimeout) {
+        this.onTimeout = onTimeout;
+    }
+    create(key, timeoutMs) {
+        if (this.entries.has(key))
+            throw new Error('An equivalent AirPlay request is already pending');
+        return new Promise((resolve, reject) => {
+            const finish = () => { clearTimeout(timer); this.entries.delete(key); };
+            const timer = setTimeout(() => {
+                const error = new Error('AirPlay request timed out');
+                this.reject(key, error);
+                this.onTimeout(error);
+            }, timeoutMs);
+            this.entries.set(key, {
+                resolve: value => { finish(); resolve(value); },
+                reject: error => { finish(); reject(error); },
+            });
+        });
+    }
+    has(key) { return this.entries.has(key); }
+    resolve(key, value) { this.entries.get(key)?.resolve(value); }
+    reject(key, error) { this.entries.get(key)?.reject(error); }
+    rejectAll(error) {
+        for (const entry of this.entries.values())
