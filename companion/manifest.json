{
	"$schema": "../node_modules/@companion-module/base/assets/manifest.schema.json",
	"type": "connection",
	"id": "apple-tv-pyatv",
	"name": "Apple TV (pyatv)",
	"shortname": "Apple TV",
	"description": "Persistent Apple TV control via a local pyatv worker",
	"version": "0.0.0",
	"license": "MIT",
	"repository": "git+https://github.com/cbusillo/companion-module-apple-tv.git",
	"bugs": "https://github.com/cbusillo/companion-module-apple-tv/issues",
	"maintainers": [
		{
			"name": "Chris Busillo"
		}
	],
	"runtime": {
		"type": "node22",
		"api": "nodejs-ipc",
		"apiVersion": "0.0.0",
		"entrypoint": "../dist/main.js",
		"permissions": {
			"filesystem": true,
			"child-process": true
		}
	},
	"legacyIds": [],
	"manufacturer": "Apple",
	"products": ["Apple TV"],
	"keywords": ["media", "remote control", "tvOS"]
}
