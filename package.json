{
  "name": "companion-module-apple-tv",
  "version": "0.5.1-dev.9",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "postinstall": "husky",
    "format": "prettier -w .",
    "package": "run build && companion-module-build && node tests/module-api-check.mjs",
    "build": "rimraf dist && run build:main",
    "build:main": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint:raw": "eslint",
    "lint": "run lint:raw .",
    "test": "node --test tests/*.test.mjs",
    "test:package": "node tests/package-smoke.mjs"
  },
  "companion": {
    "minimumVersion": "5.1.0",
    "moduleApiVersions": "2 - 2.2.x"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cbusillo/companion-module-apple-tv.git"
  },
  "engines": {
    "node": "^22.22.1",
    "yarn": "^4"
  },
  "dependencies": {
    "@companion-module/base": "2.2.1",
    "node-appletv-remote": "patch:node-appletv-remote@npm%3A0.4.0#~/experiments/node-library/patches/node-appletv-remote-npm-0.4.0-4a36632b41.patch"
  },
  "devDependencies": {
    "@companion-module/tools": "^3.1.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semver": "^7.8.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "resolutions": {
    "node-appletv-remote/bplist-parser": "^0.5.0"
  },
  "prettier": "@companion-module/tools/.prettierrc.json",
  "lint-staged": {
    "*.{css,json,md,scss}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,jsx}": [
      "yarn lint:raw --fix"
    ]
  },
  "packageManager": "yarn@4.17.0",
  "files": [
    "dist",
    "companion",
    "LICENSE",
    "LICENSE-MCR"
  ]
}
